service firebase.storage {
  match /b/{bucket}/o {
    // Task attachments: only faculty who created the task can write
    match /task_attachments/{taskId}/{fileName} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/tasks/$(taskId));
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.createdBy == request.auth.uid
        && request.resource.size < 50 * 1024 * 1024; // 50MB max
    }

    // Student submissions: students can upload their own, anyone in targetUids can read
    match /task_submissions/{taskId}/{studentUid}/{fileName} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.targetUids;
      allow write: if request.auth != null
        && request.auth.uid == studentUid
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && request.auth.uid in get(/databases/$(database)/documents/tasks/$(taskId)).data.targetUids
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.allowSubmissions == true
        && request.resource.size < 50 * 1024 * 1024; // 50MB max
    }
  }
}
